{"graph":{"composes":[],"nodes":["claim_1","claim_2","claim_3","claim_4","claim_5","claim_6","claim_7","claim_8","claim_9","claim_10","claim_11","claim_12","claim_13","claim_14","claim_15","claim_16","claim_17","claim_18","claim_19","claim_20","claim_21","claim_22","claim_23","claim_24","claim_25","note_1"],"operators":[],"strategies":[]},"knowledges":{"claim_1":{"content":{"canonical":"Winning-ticket initializations discovered by iterative magnitude pruning on large, complex natural-image source datasets produce sparse initializations that, when used to train a VGG19 or ResNet50 architecture on other natural-image target datasets, frequently achieve test accuracies on the target tasks that are close to the accuracies obtained by winning tickets discovered directly on those target datasets."},"source_anchor_ids":["anchor_claim_1"],"type":"claim"},"claim_10":{"content":{"canonical":"There are optimizer-dependent nuances in behavior in the transfer described in claim 8."},"source_anchor_ids":["anchor_claim_10"],"type":"claim"},"claim_11":{"content":{"canonical":"Tickets transferred from SGD to Adam sometimes under-perform random tickets at low pruning fractions but outperform random tickets at high pruning fractions."},"source_anchor_ids":["anchor_claim_11"],"type":"claim"},"claim_12":{"content":{"canonical":"A winning ticket discovered on CIFAR-10a (a subset of the CIFAR-10 dataset containing 25,000 training images with 2,500 images per class), transfers to a disjoint subset CIFAR-10b from the same data distribution and improves training on that held-out subset relative to random sparse initializations."},"source_anchor_ids":["anchor_claim_12"],"type":"claim"},"claim_13":{"content":{"canonical":"The within-distribution transfer described in claim 12 holds for both VGG19 and ResNet50."},"source_anchor_ids":["anchor_claim_13"],"type":"claim"},"claim_14":{"content":{"canonical":"ResNet50 showed sensitivity at low pruning fractions, occasionally under-performing random tickets when few weights are pruned."},"source_anchor_ids":["anchor_claim_14"],"type":"claim"},"claim_15":{"content":{"canonical":"When performing magnitude pruning for winning-ticket discovery on VGG19 trained on CIFAR-10, globally ranking weights across all layers and pruning the smallest-magnitude weights globally yields higher-performing sparse subnetworks than pruning a fixed fraction per layer."},"source_anchor_ids":["anchor_claim_15"],"type":"claim"},"claim_16":{"content":{"canonical":"Under global magnitude pruning the pruning fractions vary across layers: deeper convolutional layers are pruned more heavily while early layers retain a much larger fraction of their parameters."},"source_anchor_ids":["anchor_claim_16"],"type":"claim"},"claim_17":{"content":{"canonical":"For VGG19 trained on CIFAR-10, the structure of the pruning mask contains substantial information useful for training sparse networks."},"source_anchor_ids":["anchor_claim_17"],"type":"claim"},"claim_18":{"content":{"canonical":"Comparing (a) preserved winning-ticket masks, (b) masks permuted only within layers (local permutation), and (c) masks permuted across all layers (global permutation) shows that locally permuting a mask degrades performance moderately while globally permuting the mask degrades performance dramatically."},"source_anchor_ids":["anchor_claim_18"],"type":"claim"},"claim_19":{"content":{"canonical":"A fair \"random ticket\" baseline for evaluating a winning-ticket initialization should randomize both weight values and mask structure (global permutation)."},"source_anchor_ids":["anchor_claim_19"],"type":"claim"},"claim_2":{"content":{"canonical":"The transferability described in claim 1 is observed across a wide range of pruning fractions."},"source_anchor_ids":["anchor_claim_2"],"type":"claim"},"claim_20":{"content":{"canonical":"For obtaining competitive winning tickets in the large-model and large-dataset regime of natural-image classification, an iterative magnitude-pruning schedule with pruning fraction per iteration 0.2 (20% of remaining parameters) over up to 30 iterations combined with late resetting to parameters at a small early training iteration—resetting to the parameters after 1 epoch for Fashion-MNIST, SVHN, CIFAR-10 and CIFAR-100, and after 3 epochs for ImageNet and Places365—produced effective winning tickets, with learning-rate annealing schedules and other hyperparameters matched per model family."},"source_anchor_ids":["anchor_claim_20"],"type":"claim"},"claim_21":{"content":{"canonical":"Winning-ticket initializations discovered by iterative magnitude pruning on ImageNet, Places365, and, to a lesser extent, CIFAR-100 produce sparse initializations that, when used to train a VGG19 or ResNet50 architecture on SVHN, Fashion-MNIST, CIFAR-10, CIFAR-100, ImageNet, and Places365, frequently achieve test accuracies on the target tasks that are close to the accuracies obtained by winning tickets discovered directly on those target datasets."},"source_anchor_ids":["anchor_claim_21"],"type":"claim"},"claim_22":{"content":{"canonical":"The transferability described in claim 1 is observed across a wide range of pruning fractions, including very high sparsity."},"source_anchor_ids":["anchor_claim_22"],"type":"claim"},"claim_23":{"content":{"canonical":"Winning tickets discovered on larger source datasets—both in terms of number of training examples and number of output classes—transfer substantially better to SVHN, Fashion-MNIST, CIFAR-10, CIFAR-100, ImageNet, and Places365 than tickets discovered on smaller source datasets, for both VGG19 and ResNet50 architectures."},"source_anchor_ids":["anchor_claim_23"],"type":"claim"},"claim_24":{"content":{"canonical":"Holding training-set size fixed, CIFAR-100, a source dataset with 100 classes, produced tickets that generalized better across targets than CIFAR-10, a source dataset with 10 classes."},"source_anchor_ids":["anchor_claim_24"],"type":"claim"},"claim_25":{"content":{"canonical":"Under global magnitude pruning the pruning fractions vary across layers: deeper convolutional layers are pruned more heavily while the first convolutional layer retains a much larger fraction of its parameters."},"source_anchor_ids":["anchor_claim_25"],"type":"claim"},"claim_3":{"content":{"canonical":"Larger / more class-rich source datasets produced stronger cross-dataset transfer than smaller sources."},"source_anchor_ids":["anchor_claim_3"],"type":"claim"},"claim_4":{"content":{"canonical":"CIFAR-100 tickets generalize better than CIFAR-10 tickets despite both having 50,000 training examples."},"source_anchor_ids":["anchor_claim_4"],"type":"claim"},"claim_5":{"content":{"canonical":"Winning tickets discovered on larger source datasets—both in terms of number of training examples and number of output classes—transfer substantially better to other natural-image classification datasets than tickets discovered on smaller source datasets, for both VGG19 and ResNet50 architectures."},"source_anchor_ids":["anchor_claim_5"],"type":"claim"},"claim_6":{"content":{"canonical":"The effect described in claim 5, whereby winning tickets discovered on larger source datasets transfer substantially better to other natural-image classification datasets than tickets discovered on smaller source datasets, is not solely explained by raw training-set size."},"source_anchor_ids":["anchor_claim_6"],"type":"claim"},"claim_7":{"content":{"canonical":"Holding training-set size fixed, a source dataset with many classes produced tickets that generalized better across targets than one with few classes."},"source_anchor_ids":["anchor_claim_7"],"type":"claim"},"claim_8":{"content":{"canonical":"Winning-ticket initializations generated with one optimizer generalize to training with a different optimizer on natural-image classification datasets."},"source_anchor_ids":["anchor_claim_8"],"type":"claim"},"claim_9":{"content":{"canonical":"VGG19 tickets found using SGD with momentum or using Adam, when re-used with the alternate optimizer, achieve high performance that is comparable to tickets discovered under the target optimizer."},"source_anchor_ids":["anchor_claim_9"],"type":"claim"},"note_1":{"content":{"canonical":"elaboration of claim 20: Learning-rate annealing schedules and other hyperparameters were matched per model family"},"source_anchor_ids":["anchor_note_1"],"type":"note"}},"package":{"name":"run_20260825T081914Z_e7ac3ebf","namespace":"papers","paper_id":"run_20260825T081914Z_e7ac3ebf","version":"1"},"revision":{"content_hash":"ddb7442094ea9096ead2f4461947966f74a66f7a4bb0a115f3c3bd57684b5e4b","parent_hash":null,"revision_id":"revision_run_20260825T081914Z_e7ac3ebf_step_1","supersedes":null},"schema_version":"1.0.0","workflow":{"gaps":[],"non_reasoning_links":[{"id":"relation_1","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_6","connects":[18,19],"expression":"[18] 推出 [19]"},"relation_index":0},"reasoning":false,"sources":["claim_18"],"target":"claim_19"},{"id":"relation_2","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_1","connects":[4,3],"expression":"[4] 是 [3] 的例子或证据"},"relation_index":1},"reasoning":false,"sources":["claim_4"],"target":"claim_3"},{"id":"relation_3","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_2","connects":[7,6],"expression":"[7] 是 [6] 的例子或证据"},"relation_index":2},"reasoning":false,"sources":["claim_7"],"target":"claim_6"},{"id":"relation_4","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_3","connects":[9,8],"expression":"[9] 是 [8] 的例子或证据"},"relation_index":3},"reasoning":false,"sources":["claim_9"],"target":"claim_8"},{"id":"relation_5","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_3","connects":[11,10],"expression":"[11] 是 [10] 的例子或证据"},"relation_index":4},"reasoning":false,"sources":["claim_11"],"target":"claim_10"},{"id":"relation_6","link_type":"impor