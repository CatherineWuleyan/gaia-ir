{"graph":{"composes":[],"nodes":["claim_12","claim_13","claim_14","claim_O01","claim_O02","claim_O03"],"operators":[],"strategies":[]},"knowledges":{"claim_12":{"content":{"canonical":"A winning ticket discovered on CIFAR-10a (a subset of the CIFAR-10 dataset containing 25,000 training images with 2,500 images per class), transfers to a disjoint subset CIFAR-10b from the same data distribution and improves training on that held-out subset relative to random sparse initializations."},"source_anchor_ids":["anchor_claim_12","anchor_paragraph_3"],"type":"claim"},"claim_13":{"content":{"canonical":"The within-distribution transfer described in claim 12 holds for both VGG19 and ResNet50."},"source_anchor_ids":["anchor_claim_13","anchor_paragraph_p0007"],"type":"claim"},"claim_14":{"content":{"canonical":"ResNet50 showed sensitivity at low pruning fractions, occasionally under-performing random tickets when few weights are pruned."},"source_anchor_ids":["anchor_claim_14","anchor_paragraph_3"],"type":"claim"},"claim_O01":{"content":{"canonical":"Under transfer within the same data distribution from CIFAR-10a to CIFAR-10b using ResNet50 models at extreme pruning fractions, comparing both CIFAR-10a and CIFAR-10b winning tickets with random tickets on performance showed higher performance; uncertainty: mean ± standard deviation across six random seeds."},"source_anchor_ids":["anchor_paragraph_3"],"type":"observation_claim"},"claim_O02":{"content":{"canonical":"Under transfer within the same data distribution from CIFAR-10a to CIFAR-10b using ResNet50 models at low pruning fractions, comparing both CIFAR-10a and CIFAR-10b winning tickets with random tickets on performance showed lower performance; uncertainty: mean ± standard deviation across six random seeds."},"source_anchor_ids":["anchor_paragraph_3"],"type":"observation_claim"},"claim_O03":{"content":{"canonical":"Under transfer within the same data distribution from CIFAR-10a to CIFAR-10b, where CIFAR-10 was divided into t