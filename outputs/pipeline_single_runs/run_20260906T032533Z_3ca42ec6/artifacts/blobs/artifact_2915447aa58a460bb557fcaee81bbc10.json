{"graph":{"composes":[],"nodes":["claim_1","claim_2","claim_3","claim_4","claim_5","claim_6","claim_7","claim_8","claim_9","claim_10","claim_11","claim_12","claim_13","claim_14","claim_15","claim_16","claim_17","claim_18","claim_19"],"operators":[],"strategies":[]},"knowledges":{"claim_1":{"content":{"canonical":"The MESSAGE, AGGREGATE, and UPDATE functions of any message-passing GNN are replaced by their quaternion counterparts so that the layerwise message-passing semantics are preserved in quaternion space."},"source_anchor_ids":["anchor_claim_1"],"type":"claim"},"claim_10":{"content":{"canonical":"(d) graph classification on MUTAG: GCN 83.54 ± 0.40 accuracy with 4.8K parameters vs QGCN 88.61 ± 0.66 accuracy with 4.4K parameters."},"source_anchor_ids":["anchor_claim_10"],"type":"observation_claim"},"claim_11":{"content":{"canonical":"Across all tasks and datasets evaluated, quaternion variants of standard GNN architectures frequently perform within a small margin of the corresponding real models and sometimes exceed their performance while consistently having approximately one-fourth the trainable parameter count of the corresponding real models."},"source_anchor_ids":["anchor_claim_11"],"type":"claim"},"claim_12":{"content":{"canonical":"Winning graph-lottery tickets exist for both real-valued GNNs and QMPNNs."},"source_anchor_ids":["anchor_claim_12"],"type":"claim"},"claim_13":{"content":{"canonical":"Magnitude-based iterative pruning identifies subnetworks that match baseline performance at sparsity levels down to approximately 1–20% of the original parameter count across multiple architectures and tasks."},"source_anchor_ids":["anchor_claim_13"],"type":"claim"},"claim_14":{"content":{"canonical":"QMPNN variants scale to large graph datasets and maintain performance comparable to real-valued GNNs while using fewer parameters."},"source_anchor_ids":["anchor_claim_14"],"type":"claim"},"claim_15":{"content":{"canonical":"on OGBN-Arxiv node classification, GCN achieves 72.8 ± 1.5 accuracy with 145.1K parameters versus QGCN 72.3 ± 1.6 with 43.5K parameters;"},"source_anchor_ids":["anchor_claim_15"],"type":"observation_claim"},"claim_16":{"content":{"canonical":"on OGBG-COLLAB link prediction, QGCN achieves Hits@50 45.80 ± 1.35 with 6.4K parameters compared to GCN 44.02 ± 1.57 with 12.5K parameters."},"source_anchor_ids":["anchor_claim_16"],"type":"observation_claim"},"claim_17":{"content":{"canonical":"the quaternion reparameterization is effective on large-scale graph benchmarks."},"source_anchor_ids":["anchor_claim_17"],"type":"claim"},"claim_18":{"content":{"canonical":"When the three QMPNN variants QGCN, QGAT, and QSAGE of standard GNN architectures are trained under the same hyperparameters as those standard GNN architectures and evaluated on standard datasets, the quaternion models achieve comparable or better accuracy, ROC-AUC, or Hits@K (proportion of top-K predictions that are correct) while using roughly one-fourth of the trainable parameters of those standard GNN architectures."},"source_anchor_ids":["anchor_claim_18"],"type":"claim"},"claim_19":{"content":{"canonical":"Magnitude-based iterative pruning identifies subnetworks that match baseline performance at sparsity levels down to approximately 1–20% of the original parameter count across the architectures QGCN, QGAT, and QSAGE and tasks."},"source_anchor_ids":["anchor_claim_19"],"type":"claim"},"claim_2":{"content":{"canonical":"Representing layer weights as quaternion matrices and grouping four real feature channels into one quaternion reduces the number of independent trainable real parameters by a factor of four relative to an equivalent real-valued GNN weight matrix."},"source_anchor_ids":["anchor_claim_2"],"type":"claim"},"claim_3":{"content":{"canonical":"A quaternion weight mapping from $F$ real input features to $F'$ real outputs uses $F/4\\times F'/4$ quaternion entries, yielding one-fourth the degrees of freedom of the corresponding real weight matrix."},"source_anchor_ids":["anchor_claim_3"],"type":"claim"},"claim_4":{"content":{"canonical":"Quaternion matrix multiplications have the same asymptotic time complexity as the corresponding real matrix multiplications."},"source_anchor_ids":["anchor_claim_4"],"type":"claim"},"claim_5":{"content":{"canonical":"The parameter reduction described in claim 2 is achieved without increasing matrix-multiplication time complexity. [Referenced claim 2: Representing layer weights as quaternion matrices and grouping four real feature channels into one quaternion reduces the number of independent trainable real parameters by a factor of four relative to an equivalent real-valued GNN weight matrix.]"},"source_anchor_ids":["anchor_claim_5","anchor_claim_2"],"type":"claim"},"claim_6":{"content":{"canonical":"When QMPNN variants of standard GNN architectures are trained under the same hyperparameters as those standard GNN architectures and evaluated on standard datasets, the quaternion models achieve comparable or better accuracy, ROC-AUC, or Hits@K (proportion of top-K predictions that are correct) while using roughly one-fourth of the trainable parameters of those standard GNN architectures."},"source_anchor_ids":["anchor_claim_6"],"type":"claim"},"claim_7":{"content":{"canonical":"(a) node classification on Cora: real GCN 85.2 ± 1.3 accuracy with 140.5K parameters vs QGCN 84.1 ± 1.5 accuracy with 42.1K parameters;"},"source_anchor_ids":["anchor_claim_7"],"type":"observation_claim"},"claim_8":{"content":{"canonical":"(b) node classification on PubMed: GCN 79.1 ± 1.2 with 131.9K parameters vs QGCN 78.4 ± 1.4 with 41.7K parameters;"},"source_anchor_ids":["anchor_claim_8"],"type":"observation_claim"},"claim_9":{"content":{"canonical":"(c) link prediction on CORA: GCN ROC-AUC 79.27 ± 0.47 with 96.0K parameters vs QGCN ROC-AUC 83.55 ± 0.03 with 27.2K parameters;"},"source_anchor_ids":["anchor_claim_9"],"type":"observation_claim"},"note_1":{"content":{"canonical":"elaboration of claim 1: the MESSAGE, AGGREGATE, and UPDATE functions of any message-passing GNN are replaced by their quaternion counterparts so that [Referenced claim 1: The MESSAGE, AGGREGATE, and UPDATE functions of any message-passing GNN are replaced by their quaternion counterparts so that the layerwise message-passing semantics are preserved in quaternion space.]"},"source_anchor_ids":["anchor_note_1","anchor_claim_1"],"type":"note"}},"package":{"name":"paper_3ca42ec6","namespace":"papers","paper_id":"run_20260906T032533Z_3ca42ec6","version":"1"},"revision":{"content_hash":"930b92a2119db2ccbf0c654d2e2a95462f895702ab9c9e16e9e8a02aaf3be04e","parent_hash":null,"revision_id":"revision_run_20260906T032533Z_3ca42ec6_step_1","supersedes":null},"schema_version":"1.1.0","workflow":{"gaps":[],"non_reasoning_links":[{"id":"relation_1","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_2","connects":[4,5],"expression":"[4] 推出 [5]"},"relation_index":0},"reasoning":false,"sources":["claim_4"],"target":"claim_5"},{"id":"relation_2","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_6","connects":[14,15,16,17],"expression":"([14] 且 [15] 且 [16]) 推出 [17]"},"relation_index":1},"reasoning":false,"sources":["claim_14","claim_15","claim_16"],"target":"claim_17"},{"id":"relation_3","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_2","connects":[3,2],"expression":"[3] 是 [2] 的例子或证据"},"relation_index":2},"reasoning":false,"sources":["claim_3"],"target":"claim_2"},{"id":"relation_4","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_2","connects":[4,5],"expression":"[4] 是 [5] 的例子或证据"},"relation_index":3},"reasoning":false,"sources":["claim_4"],"target":"claim_5"},{"id":"relation_5","link_type":"imported_relation","metadata":{"relation":{"conclusion":"conclusion_3","connects":[7,18],"expression":"[7] 是 [18] 的例子或证据"},"relation_index":4},"reasoning":false,"sources":["claim_7"],"target":"cla