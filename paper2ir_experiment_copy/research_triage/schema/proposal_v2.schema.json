{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol_version", "task_id", "candidate_next_steps", "next_step", "reason", "evidence", "conditions", "experiment_card", "decision_rule", "uncertainty", "retrieval_trace"],
  "properties": {
    "protocol_version": {"const": "2"},
    "task_id": {"type": "string", "minLength": 1},
    "candidate_next_steps": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "next_step": {"type": "string", "minLength": 1, "maxLength": 1000},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_type", "ref_id", "role"],
        "properties": {
          "ref_type": {"enum": ["paper_anchor", "external_text", "graph_node", "graph_edge"]},
          "ref_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["support", "limitation", "context"]},
          "quote": {"type": "string", "maxLength": 1000}
        },
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "properties": {"key": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "experiment_card": {"$ref": "#/$defs/experiment_card"},
    "decision_rule": {"type": "string", "minLength": 1, "maxLength": 1000},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 1000},
    "retrieval_trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "arguments", "returned_ids", "purpose"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "arguments": {"type": "object"},
          "returned_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "experiment_card": {
      "type": "object",
      "required": ["baseline", "treatment", "controls", "metrics", "entrypoint", "expected_observation", "falsifier", "budget"],
      "properties": {
        "baseline": {"type": "string", "minLength": 1},
        "treatment": {"type": "string", "minLength": 1},
        "controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "entrypoint": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "expected_observation": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1},
        "budget": {
          "type": "object",
          "required": ["max_seconds", "max_gpu_hours"],
          "properties": {
            "max_seconds": {"type": "number", "minimum": 0},
            "max_gpu_hours": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
