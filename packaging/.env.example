# Optional environment configuration.  Prefer `./ariadne/run.sh config init`
# so secrets are stored in ~/.config/ariadne/config.json with mode 0600.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MERGE_MODEL=deepseek-v4-flash

# Bohr / LKM (optional if you already ran `bohr auth login`)
BOHR_ACCESS_KEY=
ARIADNE_BOHR_PROFILE=default
